// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Filme {
  id          Int           @id @default(autoincrement())
  titulo      String        @db.VarChar(30)
  genero      String?       @db.VarChar(30)
  sinopse     String?       @db.Text
  diretor     String        @db.VarChar(30)
  ano         Int           @db.SmallInt
  duracao     Int?           @db.SmallInt
  preco       Decimal       @db.Decimal(10, 2)
  destaque    Boolean       @default(false)
  banner      String
  poster      String
  avaliacoes  Float[] 
  elenco      String[]
  carrinhos   Carrinho[]
  alugueis    Aluguel[]
  comentarios Comentario[]
  
  @@map("filmes")
}

model Cliente {
  id          Int          @id @default(autoincrement())
  nome        String       @db.VarChar(60)
  email       String       @db.VarChar(40) @unique
  senha       String       @db.VarChar(60) 
  carrinho    Carrinho? 
  alugueis    Aluguel[]
  comentario  Comentario[]
  
  @@map("clientes")
}

model Carrinho {
  id        Int     @id @default(autoincrement())
  cliente   Cliente @relation(fields: [clienteId], references: [id])
  clienteId Int     @unique
  filmes    Filme[] 
  
  @@map("carrinhos")
}

model Aluguel {
  id            Int      @id @default(autoincrement())
  cliente       Cliente  @relation(fields: [clienteId], references: [id])
  clienteId     Int      
  filmes        Filme[]
  valor         Decimal  @db.Decimal(10, 2)
  dataInicial   DateTime @default(now())
  dataDevolucao DateTime @default(dbgenerated("NOW() + interval '15 days'"))
  
  @@map("aluguel")
}

model Comentario {
  id        Int     @id @default(autoincrement())
  cliente   Cliente @relation(fields: [clienteId], references: [id])
  clienteId Int     
  filme     Filme   @relation(fields: [filmeId], references: [id])
  filmeId   Int     

  @@map("comentario")
}